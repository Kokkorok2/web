<picture class="<%= cls %>__picture">
  <source type="image/webp" srcset="images/<%= course.slug %>-320.webp 320w, images/<%= course.slug %>-640.webp 640w, images/<%= course.slug %>-960.webp 960w" sizes="<%= sizes %>" />
  <img class="<%= cls %>__image" src="images/<%= course.slug %>-640.jpg" srcset="images/<%= course.slug %>-320.jpg 320w, images/<%= course.slug %>-640.jpg 640w, images/<%= course.slug %>-960.jpg 960w" sizes="<%= sizes %>" width="640" height="320" alt="Cover image for the course <%= course.title %>" loading="<%= loading %>" />
</picture>
