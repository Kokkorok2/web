{
  "name": "it-courses-catalog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"json-server --watch api/db.json --routes api/routes.json --port 5174\"",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:html": "html-validate dist/*.html",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.8.0",
    "gh-pages": "^6.1.1",
    "globals": "^15.9.0",
    "html-validate": "^8.20.0",
    "json-server": "^0.17.4",
    "sass": "^1.80.0",
    "vite": "^5.4.0",
    "vite-plugin-ejs": "^1.7.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dayjs": "^1.11.11"
  }
}
